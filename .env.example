# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****
# Oregon warehouse. Trove calls POST /v1/evidence when this key is set.
OREGON_DATA_URL=https://52.41.96.156
OREGON_DATA_API_KEY=

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# Stripe Billing. STRIPE_API is used when set. Do not commit the live or test secret.
STRIPE_API=****
STRIPE_SECRET_KEY=****
STRIPE_WEBHOOK_SECRET=****
STRIPE_PUBLISHABLE_KEY=****
STRIPE_PRICE_FORTY=****
STRIPE_PRICE_HUNDRED=****
STRIPE_PRICE_UNLIMITED=****
STRIPE_PORTAL_CONFIGURATION_ID=****

# Owner texts. The alert Lambda URL and the shared secret. Leave both blank locally.
OWNER_ALERT_URL=
OWNER_ALERT_SECRET=
